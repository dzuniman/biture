{
  "name": "quote2cash-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode biture-development",
    "staging": "vite --mode biture-staging",
    "production": "vite --mode biture-production",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:biture:staging": "vite build --mode biture-staging --config ./quote2cash-web/vite.config.js",
    "build:biture:production": "vite build --mode biture-production --config ./quote2cash-web/vite.config.js",
    "build:epec:production": "vite build --mode epec-production --config ./quote2cash-web/vite.config.js",
    "build:ditau:production": "vite build --mode ditau-production --config ./quote2cash-web/vite.config.js",
    "deploy:biture:staging:backend": "xcopy /Y .\\api\\.htaccess-biture-staging .\\api\\.htaccess && node ./api/deploy-biture-staging-backend.cjs",
    "deploy:biture:production:backend": "xcopy /Y .\\api\\.htaccess-biture-production .\\api\\.htaccess && node ./api/deploy-biture-production-backend.cjs",
    "deploy:epec:production:backend": "xcopy /Y .\\api\\.htaccess-epec-production .\\api\\.htaccess && node ./api/deploy-epec-production-backend.cjs",
    "deploy:ditau:production:backend": "xcopy /Y .\\api\\.htaccess-ditau-production .\\api\\.htaccess && node ./api/deploy-ditau-production-backend.cjs",
    "deploy:biture:staging:frontend": "vite build --mode biture-staging --config ./quote2cash-web/vite.config.js && node ./quote2cash-web/deploy-biture-staging-frontend.cjs",
    "deploy:biture:production:frontend": "vite build --mode biture-production --config ./quote2cash-web/vite.config.js && node ./quote2cash-web/deploy-biture-production-frontend.cjs",
    "deploy:epec:production:frontend": "vite build --mode epec-production --config ./quote2cash-web/vite.config.js && node ./quote2cash-web/deploy-epec-production-frontend.cjs",
    "deploy:ditau:production:frontend": "vite build --mode ditau-production --config ./quote2cash-web/vite.config.js && node ./quote2cash-web/deploy-ditau-production-frontend.cjs"
  },
  "dependencies": {
    "add": "^2.0.6",
    "axios": "^1.8.6",
    "ftp-deploy": "^2.4.7",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.4.1",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@types/jspdf": "^1.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "ftp": "^0.3.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "xlsx": "^0.18.5"
  }
}