{
  "name": "quote2cash-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "staging": "vite --mode staging",
    "production": "vite --mode production",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "deploy:staging:frontend": "npm run build:staging && node deploy-staging.cjs",
    "deploy:production:frontend": "npm run build:production && node deploy-production.cjs",
    "deploy:staging:backend": "node deploy-staging-backend.cjs",
    "deploy:production:backend": "node deploy-production-backend.cjs"
  },
  "dependencies": {
    "add": "^2.0.6",
    "axios": "^1.8.6",
    "ftp-deploy": "^2.4.7",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.4.1",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@types/jspdf": "^1.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "ftp": "^0.3.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "xlsx": "^0.18.5"
  }
}